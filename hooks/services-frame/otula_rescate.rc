# Red de seguridad del gancho de services.jar (proyecto K706). Ver otula-rescate.sh.
on post-fs-data
    exec u:r:su:s0 root root -- /system/bin/sh /system/bin/otula-rescate.sh

on property:sys.boot_completed=1
    exec_background u:r:su:s0 root root -- /system/bin/sh -c "echo 0 > /data/local/tmp/otula-arranques"
